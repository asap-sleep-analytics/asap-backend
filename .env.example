# Base de datos (principal: Neon/PostgreSQL)
# Acepta `postgresql://...` (Neon por defecto) y también `postgresql+psycopg://...`.
# El backend normaliza automáticamente a `postgresql+psycopg://...`.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# Fallback secundario opcional (solo desarrollo local)
# SQLITE_DATABASE_URL=sqlite:///./asap.db
AUTO_CREATE_TABLES=false

# Doble opt-in
LEAD_CONFIRM_URL_BASE=https://api.asap-health.app/api/leads/confirm
LEAD_TOKEN_TTL_HOURS=24

# Verificación de email y recuperación de contraseña
# Base de los enlaces enviados por correo (puede apuntar a un deep link de la app móvil).
AUTH_EMAIL_VERIFY_URL_BASE=https://api.asap-health.app/api/v1/auth/email/verificar
AUTH_EMAIL_VERIFY_TOKEN_TTL_MINUTES=60
AUTH_PASSWORD_RESET_URL_BASE=https://api.asap-health.app/api/v1/auth/password/restablecer
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Seleccion de proveedor SMTP: custom | resend | sendgrid | gmail
SMTP_PROVIDER=sendgrid

# Overrides opcionales para cualquier proveedor
SMTP_HOST=
SMTP_PORT=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Credenciales
# Resend: SMTP_USERNAME por defecto es 'resend'
# SendGrid: SMTP_USERNAME por defecto es 'apikey'
# Gmail: define SMTP_USERNAME con tu cuenta y usa App Password
SMTP_USERNAME=
SMTP_PASSWORD=

# Remitente
SMTP_FROM_NAME=A.S.A.P.
SMTP_FROM_EMAIL=no-reply@asap-health.app
SMTP_REPLY_TO=support@asap-health.app

# Auth JWT
AUTH_SECRET_KEY=<cambia-esta-clave>
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=60
AUTH_ISSUER=asap-backend
APP_ENV=production

# Login social (opcional)
# Client IDs de Google OAuth separados por coma (Web/Android/iOS). Se validan como audiencia del token.
GOOGLE_CLIENT_ID=<google-web-client-id>,<google-android-client-id>,<google-ios-client-id>
# Service ID (App ID) de Sign in with Apple.
APPLE_CLIENT_ID=<apple-service-id>
# Team ID del desarrollador de Apple (opcional, para tokens Apple firmados).
APPLE_TEAM_ID=<apple-team-id>

# Admin export
ADMIN_DATASET_EXPORT_KEY=<cambia-esta-clave-admin>
ADMIN_DATASET_EXPORT_LIMIT=10000

# Métricas Prometheus (/metrics). Requiere Authorization: Bearer <token>.
# Vacío = sin protección (solo recomendado en localhost).
METRICS_TOKEN=<cambia-este-token-metrics>

# CORS (separado por comas)
CORS_ALLOWED_ORIGINS=https://asap-health.app,https://app.asap-health.app,http://localhost:3000,http://localhost:5173

# Fragmentos de audio
SLEEP_FRAGMENT_ROOT=./storage/sleep_fragments
MAX_SLEEP_FRAGMENT_SIZE_BYTES=5242880
MAX_V3_AUDIO_SIZE_BYTES=15728640

# ML de sueno
# Ruta local del modelo de Scikit-Learn (joblib). Si no existe, se usa fallback heuristico.
ML_SLEEP_MODEL_PATH=./artifacts/sleep_model.joblib
ML_V3_MODEL_DIR=./ml/models
